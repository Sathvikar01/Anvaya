# Copy to .env and set the real keys. Never commit .env.
# Gnani (gnani-vachana SDK): Prisma speech-to-text + Timbre text-to-speech.
# Get a key from https://app.gnani.ai/voice
GNANI_API_KEY=
# STT provider: gnani (default; falls back to Sarvam when Gnani fails or has no key) | sarvam
HH_RAG_STT_PROVIDER=gnani
# TTS provider for the "Listen" button: gnani (default, needs GNANI_API_KEY) | off
HH_RAG_TTS_PROVIDER=gnani
# Optional Timbre settings (timbre-v2.5 supports language + speed 0.85-1.15)
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_SPEED=1.0
# Sarvam Saaras v3: fallback STT (and the only STT provider when GNANI_API_KEY is empty).
SARVAM_API_KEY=
GROQ_API_KEY=
# Optional for deployments reachable beyond localhost. Clients send Bearer <token>.
HH_RAG_API_TOKEN=
# Optional LangGraph orchestration. Native remains the default.
HH_RAG_ORCHESTRATOR=native
